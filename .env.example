# Nusxa oling: cp .env.example .env  — va qiymatlarni o‘zgartiring
POSTGRES_DB=cybercomp
POSTGRES_USER=cybercomp
POSTGRES_PASSWORD=kuchli-parol-kiriting

# openssl rand -hex 32
JWT_SECRET=change-me-in-production

ADMIN_PASSWORD=Admin@2026
OFFICER_PASSWORD=Demo@2026

# Himoya namoyishi: 1-click demo kirish va E-IMZO simulyatsiyasi. Ochiq serverda ishdan keyin false qiling.
DEMO_MODE=true
EIMZO_DEMO_PIN=123456

# QR-kodlardagi tekshirish havolasi uchun (masalan, https://cybercomp.example.uz)
PUBLIC_BASE_URL=http://localhost
CORS_ORIGINS=*
HTTP_PORT=80
UVICORN_WORKERS=2
